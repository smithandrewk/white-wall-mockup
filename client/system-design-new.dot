digraph NewSystem {
    graph [
        rankdir=LR
        bgcolor="#fafafa"
        fontname="Helvetica Neue"
        label=<<BR/><FONT POINT-SIZE="20" FACE="Georgia"><B>WhiteWall Studios — New System</B></FONT><BR/><FONT POINT-SIZE="11" COLOR="#888888">Vercel + Acuity API + Square Payment Links + QuickBooks</FONT><BR/><BR/>>
        labelloc=t
        pad="0.5"
        nodesep=0.8
        ranksep=1.3
        dpi=300
        size="11,8"
    ]

    node [
        fontname="Helvetica Neue"
        fontsize=11
        shape=box
        style="rounded,filled"
        penwidth=0
        margin="0.3,0.2"
    ]

    edge [
        fontname="Helvetica Neue"
        fontsize=9
        fontcolor="#555555"
        color="#444444"
        penwidth=1.5
        arrowsize=0.8
    ]

    // Nodes
    customer [
        label=<<B>Customer</B><BR/><FONT POINT-SIZE="8" COLOR="#ffffffbb">Custom 5-step booking UI<BR/>Never leaves site until payment</FONT>>
        fillcolor="#8ba7b8"
        fontcolor=white
        shape=oval
    ]

    vercel [
        label=<<B>Vercel</B><BR/><FONT POINT-SIZE="8" COLOR="#ffffffbb">Website hosting + serverless functions<BR/>Custom booking UI (HTML/CSS/JS)<BR/>API proxy for Acuity (no CORS)<BR/>Checkout + callback endpoints<BR/>Cron: cleanup abandoned blocks</FONT>>
        fillcolor="#2a2a2a"
        fontcolor=white
    ]

    acuity [
        label=<<B>Acuity Scheduling</B><BR/><FONT POINT-SIZE="8" COLOR="#ffffffbb">Calendar + availability API<BR/>Blocks hold slots during payment<BR/>Appointments created AFTER payment<BR/>Sends confirmation email<BR/>Drew still manages calendar here</FONT>>
        fillcolor="#c4a882"
        fontcolor=white
    ]

    square [
        label=<<B>Square</B><BR/><FONT POINT-SIZE="8" COLOR="#ffffffbb">Payment Links (hosted checkout)<BR/>Customer pays on Square's page<BR/>Redirects back to Vercel callback<BR/>Separate app, same merchant account</FONT>>
        fillcolor="#4a90d9"
        fontcolor=white
    ]

    quickbooks [
        label=<<B>QuickBooks Online</B><BR/><FONT POINT-SIZE="8" COLOR="#ffffffbb">Accounting / source of truth<BR/>Gets invoice from Acuity<BR/>(same $0 draft as current site)</FONT>>
        fillcolor="#2e7d32"
        fontcolor=white
    ]

    drew [
        label=<<B>Drew (Admin)</B><BR/><FONT POINT-SIZE="8" COLOR="#ffffffbb">Same workflow as today<BR/>Manages calendar in Acuity<BR/>Views revenue in QuickBooks + Square</FONT>>
        fillcolor="#6a6a6a"
        fontcolor=white
        shape=oval
    ]

    // Happy path
    customer -> vercel [label="  Steps 1-5: duration, details,\n  waiver, add-ons, schedule  "]
    vercel -> acuity [label="  1. GET availability (dates/times)\n  2. POST block (hold slot)\n  3. POST appointment (after pay)  "]
    vercel -> square [label="  Create Payment Link\n  with line items  "]
    customer -> square [label="  Redirected to pay  " style=dashed]
    square -> vercel [label="  Redirect back with orderId\n  → verify → delete block\n  → create appointment  " style=dashed]
    acuity -> quickbooks [label="  Auto-syncs appointment\n  Draft invoice  "]
    acuity -> customer [label="  Confirmation email\n  (only after payment)  " style=dashed color="#2e7d32" fontcolor="#2e7d32"]
    drew -> acuity [label="  Blocks times\n  Same as today  "]
    drew -> quickbooks [label="  Views books  " style=dashed]

    // Cron
    vercel -> acuity [label="  Cron: delete\n  abandoned blocks  " style=dotted color="#c62828" fontcolor="#c62828"]
}
